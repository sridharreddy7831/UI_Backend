# ════════════════════════════════════════════════════════
# UTHSAV BACKEND - ENVIRONMENT VARIABLES
# ════════════════════════════════════════════════════════
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control
# ════════════════════════════════════════════════════════

# 🔒 NODE ENVIRONMENT
NODE_ENV=development
# production or development

# 📊 SERVER CONFIGURATION
PORT=4000
# Server port

# 🗄️ DATABASE CONFIGURATION (REQUIRED)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/uthsav_invites
# MongoDB connection string - MUST BE SET

# 🔐 JWT CONFIGURATION (REQUIRED)
JWT_SECRET=your_super_secure_random_jwt_secret_key_here_min_32_chars
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: Change this in production
# CRITICAL: Must be at least 32 characters in production

# 👤 SUPER ADMIN EMAIL (for admin registration)
SUPER_ADMIN_EMAIL=sridhar@uthsav.com
# Only this email can create new admin accounts via /api/auth/register

# 🌐 CORS CONFIGURATION
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://uthsavinvites.vercel.app
# Comma-separated list of allowed origins for CORS

# 📧 EMAIL CONFIGURATION (for inquiry alerts)
SMTP_HOST=smtp.gmail.com
# Email service host

SMTP_PORT=465
# Email service port (465 for Gmail)

SMTP_USER=your-email@gmail.com
# Email account username

SMTP_PASS=your_app_password_not_regular_password
# App-specific password (NOT your regular Gmail password)
# For Gmail: Generate at https://myaccount.google.com/apppasswords

NOTIFICATION_EMAIL=admin@uthsav.com
# Email address to receive inquiry/contact form alerts

FRONTEND_URL=http://localhost:5173
# Frontend application URL for email links

# 📝 ADMIN SEEDING (seed-users.js)
# These are optional - if not set, you'll be prompted interactively
# ADMIN_EMAIL=your-admin-email@uthsav.com
# ADMIN_PASSWORD=your_secure_password_here
# ADMIN_NAME=Your Admin Name

# ════════════════════════════════════════════════════════
# 🔒 SECURITY NOTES:
# ════════════════════════════════════════════════════════
# 1. JWT_SECRET is MANDATORY - server will not start without it
# 2. Use strong, random JWT_SECRET (32+ chars in production)
# 3. Never use default or hardcoded passwords
# 4. For Gmail SMTP, use App Passwords not your account password
# 5. Keep .env file out of version control
# 6. Rotate secrets regularly in production
# 7. Use HTTPS in production
# 8. Set NODE_ENV=production in production
# ════════════════════════════════════════════════════════
